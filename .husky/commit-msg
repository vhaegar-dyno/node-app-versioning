BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

# Specify the branch name to bypass
BYPASS_BRANCH="main"

# Skip commit message validation if on the bypass branch
if [ "$BRANCH_NAME" = "$BYPASS_BRANCH" ]; then
  exit 0
fi

# Run commit message linting (Modify based on your setup)
npx --no-install commitlint --edit $1