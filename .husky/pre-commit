# Branch Naming Validation
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

BYPASS_BRANCH_1="main"
BYPASS_BRANCH_2="dev"

# if [ "$BRANCH_NAME" = "$BYPASS_BRANCH" ]; then
if [ "$BRANCH_NAME" = "$BYPASS_BRANCH_1" ] || [ "$BRANCH_NAME" = "$BYPASS_BRANCH_2" ]; then
  # Run formatting and linting
  # npm run format:fix
  # npm run lint:fix

  # Add the fixed files to staging
  git add .
  exit 0
fi

if [[ ! $BRANCH_NAME =~ ^(feat|fix|release|refactor)\/[a-z0-9._-]+$ ]]; then
  echo "❌ Branch name '$BRANCH_NAME' does not follow the naming convention."
  echo "✅ Allowed formats: 'feat/', 'fix/', 'release/', 'refactor/', 'doc/' followed by a descriptive name."
  exit 1
fi

